#!/usr/bin/env bash

set -eo pipefail
shopt -s inherit_errexit

profile="/nix/var/nix/profiles/system"

unset action machine jobs system target

function usage {
    echo 'nixos instantiate|build|copy|test|switch|boot|vm|install [ MACHINE ]'
    echo '  -f, --file     Nix file to find machine attribute in.'
    echo '  -p, --profile  Path to the profile to update.'
    echo '  -t, --target   SSH hostname to update.'
    echo '  -j, --jobs     Number of simultaneous jobs to use when building.'
    exit 1
}

options=$(getopt    \
  -o h  -l help     \
  -o f: -l file:    \
  -o p: -l profile: \
  -o t: -l target:  \
  -o j: -l jobs:    \
  -- "$@")

test $? -eq 0 || usage

eval set -- "$options"

while [ $# -gt 0 ]; do
  i="$1"; shift 1
  case "$i" in
    --help|-h)
      usage
      ;;
    --profile|-p)
      profile="$1"
      shift
      ;;
    --target|-t)
      target="$1"
      shift
      ;;
    --file|-f)
      NIXOS_MACHINES="$1"
      shift
      ;;
    --jobs|-j)
      jobs="-j$1"
      shift
      ;;
    --)
      break
      ;;
  esac
done

action="$1"
machine="$2"

if [ -n "$3" ]; then
  echo "$0: Unsupported option: $3"
fi

if [ -z "$machine" -a -n "$target" ]; then
  echo "$0: Cannot set target without setting machine" >&2
  exit 1
fi

if [ -z "$machine" ]; then
  machine="$(hostname)"
fi

if [ -z "$target" ]; then
  target="root@$machine"
fi

atTarget="ssh $target"

case "$action" in
  boot|copy|switch|test|install)
    system=$(nix-build $jobs --no-out-link "$NIXOS_MACHINES" -A "$machine.system")
    nix-copy-closure --use-substitutes --to "$target" "$system"
    ;;
  vm)
    system=$(nix-build $jobs --no-out-link "$NIXOS_MACHINES" -A "$machine.vm")
    ls "$system"/bin/*
    ;;
  build)
    nix-build $jobs --no-out-link "$NIXOS_MACHINES" -A "$machine.system"
    ;;
  instantiate)
    nix-instantiate "$NIXOS_MACHINES" -A "$machine.system"
    ;;
  *)
    usage
    ;;
esac

case "$action" in
  boot|switch)
    $atTarget nix-env -p "$profile" --set "$system"
    $atTarget "$system/bin/switch-to-configuration" "$action"
    ;;
  test)
    $atTarget "$system/bin/switch-to-configuration" "$action"
    ;;
  install)
    $atTarget nixos-install --system "$system"
esac
